

APP_NAME=DXA-QA Platform
DEBUG=false

POSTGRES_USER=dxa
POSTGRES_PASSWORD=dxa
POSTGRES_DB=dxa


DATABASE_URL=postgresql+asyncpg://dxa:dxa@localhost:5432/dxa
ML_SERVICE_URL=http://localhost:8001
DATA_DIR=../../data/runtime

# Сгенерировать: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=480

# Вход через Госуслуги (ЕСИА): off | mock | real
# mock — тестовый контур внутри приложения, логины в README.md (раздел «Тестовые данные»)
ESIA_MODE=mock
# ESIA_BASE_URL=https://esia-portal1.test.gosuslugi.ru
# ESIA_CLIENT_ID=
# ESIA_CERT_HASH=
# ESIA_SIGNER_URL=http://signer:8080/sign

# Продакшен (docker-compose.prod.yml): домен, на который смотрит A-запись сервера
# DOMAIN=dxa.example.ru
